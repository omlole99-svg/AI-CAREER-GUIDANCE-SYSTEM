{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "connections": {
          "$connectionId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "lastOnline": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}
