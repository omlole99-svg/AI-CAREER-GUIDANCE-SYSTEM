rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PROFILES ---
    // users collection used by authService and firestoreService
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.get('points', 0) == 0 &&
                    request.resource.data.get('streak', 0) == 0;
      allow update: if request.auth != null && request.auth.uid == uid &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                      ['uid', 'email', 'points', 'streak', 'quizHistory', 'lastActiveDate', 'isAdmin']
                    );
    }

    // students collection used by streakService
    match /students/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.uid == resource.data.uid &&
                    request.resource.data.email == resource.data.email;
      
      // Activity subcollection used by activityService
      match /activity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // --- LEARNING PATHS ---
    match /learningPaths/{documentId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid &&
                    request.resource.data.get('highestUnlockedDay', 1) == 1 &&
                    request.resource.data.get('currentDay', 1) == 1;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                      ['userId', 'highestUnlockedDay', 'currentDay']
                    );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // --- CONVERSATIONS ---
    match /conversations/{chatId} {
      // Must be a participant to read/update
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
      // Must be a participant to create
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        // Must be a participant of the parent conversation to read/write messages
        allow read, write: if request.auth != null && 
                           request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.participants;
      }
    }
  }
}
